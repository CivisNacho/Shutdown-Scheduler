<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Shutdown_Scheduler_WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Shutdown_Scheduler_WinUI.Controls"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid
        x:Name="Root"
        Padding="16"
        Background="{ThemeResource AppChromeBackgroundBrush}"
        UseSystemFocusVisuals="True">
        <Grid
            x:Name="DesignSurface"
            RowSpacing="12"
            UseSystemFocusVisuals="True">
        <Grid.Resources>
            <DataTemplate x:Key="AppTargetTemplate">
                <Grid ColumnSpacing="10" MinHeight="28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Width="20"
                        Height="20"
                        CornerRadius="6"
                        Background="{ThemeResource GlassPanelSecondaryBackgroundBrush}"
                        VerticalAlignment="Center">
                        <Grid>
                            <FontIcon
                                Glyph="&#xE8D7;"
                                FontSize="12"
                                Foreground="{ThemeResource MutedTextBrush}"
                                Visibility="{Binding IsIconLoaded, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                            <Image
                                Width="16"
                                Height="16"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Source="{Binding Icon}"
                                Visibility="{Binding IsIconLoaded, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Stretch="Uniform" />
                        </Grid>
                    </Border>
                    <TextBlock
                        Grid.Column="1"
                        Text="{Binding Label}"
                        VerticalAlignment="Center"
                        TextTrimming="CharacterEllipsis" />
                </Grid>
            </DataTemplate>

            <Style x:Key="ToggleRowStyle" TargetType="Grid">
                <Setter Property="MinHeight" Value="48" />
                <Setter Property="ColumnSpacing" Value="12" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: what is scheduled (or the empty state) and the two main actions. -->
        <Border
            Padding="20,18"
            Background="{ThemeResource WindowHeroBackgroundBrush}"
            BorderBrush="{ThemeResource WindowHeroBorderBrush}"
            BorderThickness="{ThemeResource AppStrokeThickness}"
            CornerRadius="{StaticResource AppCornerRadius}">
            <Grid ColumnSpacing="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Width="56" Height="56" VerticalAlignment="Center">
                        <Border
                            CornerRadius="16"
                            Background="{ThemeResource HeroIdleBadgeBackgroundBrush}"
                            Visibility="{Binding HasActiveSchedule, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}">
                            <FontIcon
                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                Glyph="{Binding ActiveGlyph}"
                                FontSize="{Binding ActiveGlyphFontSize}"
                                Margin="{Binding ActiveGlyph, Converter={StaticResource GlyphInkMarginConverter}}"
                                Foreground="{ThemeResource HeroIdleBadgeForegroundBrush}" />
                        </Border>
                        <Border
                            CornerRadius="16"
                            Background="{ThemeResource HeroBadgeBackgroundBrush}"
                            Visibility="{Binding HasActiveSchedule, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <FontIcon
                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                Glyph="{Binding ActiveGlyph}"
                                FontSize="{Binding ActiveGlyphFontSize}"
                                Margin="{Binding ActiveGlyph, Converter={StaticResource GlyphInkMarginConverter}}"
                                Foreground="{ThemeResource HeroBadgeForegroundBrush}" />
                        </Border>
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{Binding AppTitle}" Style="{StaticResource EyebrowTextStyle}" />
                        <TextBlock
                            Text="{Binding Remaining}"
                            Style="{StaticResource HeroValueTextStyle}"
                            Visibility="{Binding HasActiveSchedule, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock
                            Text="{Binding ActiveHeadline}"
                            Style="{StaticResource HeroTitleTextStyle}"
                            Visibility="{Binding HasActiveSchedule, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}" />
                        <TextBlock
                            Text="{Binding ActiveDetail}"
                            Style="{StaticResource HeroCaptionTextStyle}"
                            TextWrapping="NoWrap"
                            TextTrimming="CharacterEllipsis"
                            ToolTipService.ToolTip="{Binding ActiveSummary}" />
                    </StackPanel>
                </Grid>

                <Grid
                    x:Name="HeaderActionsHost"
                    Grid.Column="1"
                    ColumnSpacing="8"
                    VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button
                        x:Name="ScheduleButton"
                        Content="{Binding ScheduleButtonLabel}"
                        Command="{Binding ScheduleCommand}"
                        AccessKey="S"
                        TabIndex="10"
                        AutomationProperties.Name="{Binding ScheduleButtonLabel}"
                        AutomationProperties.HelpText="Create or replace the current schedule."
                        MinWidth="140"
                        Style="{StaticResource GlassPrimaryNoHoverButtonStyle}" />
                    <Button
                        x:Name="CancelScheduleButton"
                        Grid.Column="1"
                        Content="{Binding CancelButtonLabel}"
                        Command="{Binding CancelCommand}"
                        IsEnabled="{Binding HasActiveSchedule}"
                        AccessKey="C"
                        TabIndex="11"
                        AutomationProperties.Name="{Binding CancelButtonLabel}"
                        AutomationProperties.HelpText="Cancel the active schedule."
                        MinWidth="104"
                        MinHeight="40"
                        Style="{StaticResource GlassSecondaryButtonStyle}" />
                </Grid>
            </Grid>
        </Border>

        <ScrollViewer
            x:Name="SectionsScroller"
            Grid.Row="1"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Disabled"
            VerticalScrollMode="Disabled">
        <Grid
            x:Name="MainSectionsGrid"
            ColumnSpacing="12"
            RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <!-- Schedule: action and time. -->
                <Border Style="{StaticResource GlassSectionContainerStyle}">
                    <ScrollViewer
                        HorizontalScrollBarVisibility="Disabled"
                        HorizontalScrollMode="Disabled"
                        VerticalScrollBarVisibility="Auto"
                        VerticalScrollMode="Enabled">
                        <StackPanel Spacing="16">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource SectionIconTileStyle}">
                                    <FontIcon Glyph="&#xE787;" Style="{StaticResource SectionIconStyle}" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ScheduleLabel}" Style="{StaticResource SectionHeadingTextStyle}" />
                                    <TextBlock Text="{Binding Loc[ScheduleHint]}" Style="{StaticResource SectionCaptionTextStyle}" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Spacing="10">
                                <ComboBox
                                    Header="{Binding ActionLabel}"
                                    ItemsSource="{Binding Actions}"
                                    DisplayMemberPath="Label"
                                    SelectedItem="{Binding SelectedAction, Mode=TwoWay}"
                                    TabIndex="20"
                                    AutomationProperties.Name="{Binding ActionLabel}"
                                    HorizontalAlignment="Stretch" />

                                <CheckBox
                                    Content="{Binding ForceAdminLabel}"
                                    IsChecked="{Binding IsForcedAdmin, Mode=TwoWay}"
                                    TabIndex="21"
                                    AutomationProperties.Name="{Binding ForceAdminLabel}"
                                    Visibility="{Binding IsForcedModeAvailable, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                <CheckBox
                                    Content="{Binding PreventSleepLabel}"
                                    IsChecked="{Binding PreventSleep, Mode=TwoWay}"
                                    TabIndex="22"
                                    AutomationProperties.Name="{Binding PreventSleepLabel}" />
                            </StackPanel>

                            <Border
                                Style="{StaticResource FieldGroupStyle}"
                                Visibility="{Binding IsCloseAppAction, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid x:Name="CloseAppPickerPanel" RowSpacing="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{Binding AppToCloseLabel}" TextWrapping="Wrap" />
                                    <Grid Grid.Row="1" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox
                                            VerticalAlignment="Center"
                                            HeaderTemplate="{x:Null}"
                                            ItemsSource="{Binding Items}"
                                            ItemTemplate="{StaticResource AppTargetTemplate}"
                                            SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                            PlaceholderText="{Binding NoAppsFoundLabel}"
                                            TabIndex="22"
                                            AutomationProperties.Name="{Binding AppToCloseLabel}"
                                            AutomationProperties.HelpText="Choose the running app that will be closed."
                                            HorizontalAlignment="Stretch" />
                                        <Button
                                            Grid.Column="1"
                                            Click="OnRefreshCloseAppTargetsClick"
                                            AccessKey="R"
                                            TabIndex="23"
                                            VerticalAlignment="Center"
                                            ToolTipService.ToolTip="{Binding RefreshAppsLabel}"
                                            AutomationProperties.Name="{Binding RefreshAppsLabel}"
                                            AutomationProperties.HelpText="Refresh the list of running apps."
                                            Width="36"
                                            Height="36"
                                            Padding="0"
                                            Style="{StaticResource GlassSecondaryButtonStyle}">
                                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                        </Button>
                                    </Grid>
                                    <Grid Grid.Row="2" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ProgressRing
                                            Width="14"
                                            Height="14"
                                            IsActive="{Binding IsLoading}"
                                            Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            VerticalAlignment="Center" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Text="{Binding LoadingAppsLabel}"
                                            Style="{StaticResource SectionCaptionTextStyle}"
                                            Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            VerticalAlignment="Center" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Text="{Binding NoAppsFoundLabel}"
                                            Style="{StaticResource SectionCaptionTextStyle}"
                                            Visibility="{Binding HasNoItems, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            VerticalAlignment="Center" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- "When": one clock sets the target time; it also shows how long until then. -->
                            <Border Style="{StaticResource FieldGroupStyle}" Padding="14,16">
                                <controls:TargetTimeDial
                                    x:Name="TargetDial"
                                    TabIndex="24"
                                    InLabel="{Binding Loc[InLabel]}"
                                    TodayLabel="{Binding Loc[Today]}"
                                    TomorrowLabel="{Binding Loc[Tomorrow]}"
                                    MoreDaysLabel="{Binding Loc[MoreDays]}"
                                    TimePassedLabel="{Binding Loc[TimePassed]}"
                                    AutomationProperties.Name="{Binding Loc[WhenLabel]}" />
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Conditions: optional gates checked once the time is reached. -->
                <Border
                    x:Name="SectionRegion2"
                    Grid.Column="1"
                    Style="{StaticResource GlassSectionContainerStyle}">
                    <Grid RowSpacing="16" MinWidth="0" MinHeight="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource SectionIconTileStyle}">
                                <FontIcon Glyph="&#xE71C;" Style="{StaticResource SectionIconStyle}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ConditionsLabel}" Style="{StaticResource SectionHeadingTextStyle}" />
                                <TextBlock Text="{Binding Loc[ConditionsSectionHint]}" Style="{StaticResource SectionCaptionTextStyle}" />
                            </StackPanel>
                            <Button
                                Grid.Column="2"
                                Click="OnAddConditionClick"
                                AccessKey="A"
                                TabIndex="30"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="{Binding AddConditionLabel}"
                                ToolTipService.ToolTip="{Binding AddConditionLabel}"
                                Style="{StaticResource GlassSecondaryButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE710;" FontSize="12" />
                                    <TextBlock Text="{Binding Loc[AddShort]}" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Border
                            Grid.Row="1"
                            VerticalAlignment="Top"
                            Style="{StaticResource FieldGroupStyle}"
                            Padding="16,14"
                            Visibility="{Binding HasNoConditions, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE946;" Style="{StaticResource SectionIconStyle}" VerticalAlignment="Top" Margin="0,2,0,0" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="{Binding NoConditionsLabel}" Style="{StaticResource FormRowLabelStyle}" FontWeight="SemiBold" />
                                    <TextBlock
                                        Text="{Binding Loc[NoConditionsHint]}"
                                        Style="{StaticResource SectionCaptionTextStyle}"
                                        TextWrapping="WrapWholeWords" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- ApplyLayout caps this height when sections are stacked, so the list keeps its own scroll. -->
                        <ScrollViewer
                            x:Name="ConditionsList"
                            Grid.Row="1"
                            HorizontalScrollBarVisibility="Disabled"
                            HorizontalScrollMode="Disabled"
                            VerticalScrollBarVisibility="Auto"
                            VerticalScrollMode="Enabled"
                            Visibility="{Binding HasConditions, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ItemsControl ItemsSource="{Binding Conditions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,10" Style="{StaticResource FieldGroupStyle}">
                                            <StackPanel Spacing="12">
                                                <Grid ColumnSpacing="10" MinHeight="32">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <FontIcon Glyph="{Binding Glyph}" Style="{StaticResource SectionIconStyle}" FontSize="14" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        Text="{Binding Label}"
                                                        FontWeight="SemiBold"
                                                        Style="{StaticResource FormRowLabelStyle}" />
                                                    <Button
                                                        Grid.Column="2"
                                                        Click="OnRemoveConditionClick"
                                                        TabIndex="31"
                                                        ToolTipService.ToolTip="{Binding RemoveConditionLabel}"
                                                        AutomationProperties.Name="{Binding RemoveConditionLabel}"
                                                        Style="{StaticResource GlassIconButtonStyle}">
                                                        <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                                    </Button>
                                                </Grid>

                                                <Grid
                                                    ColumnSpacing="8"
                                                    Visibility="{Binding IsNetwork, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <NumberBox
                                                        Header="{Binding RequiredBelowLabel}"
                                                        Text="{Binding NetworkThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        ValidationMode="InvalidInputOverwritten"
                                                        HorizontalAlignment="Stretch"
                                                        VerticalAlignment="Top" />
                                                    <ComboBox
                                                        Grid.Column="1"
                                                        MinWidth="110"
                                                        Header="{Binding NetworkShortLabel}"
                                                        ItemsSource="{Binding NetworkUnits}"
                                                        DisplayMemberPath="Label"
                                                        SelectedItem="{Binding SelectedNetworkUnit, Mode=TwoWay}"
                                                        HorizontalAlignment="Stretch"
                                                        VerticalAlignment="Top" />
                                                </Grid>

                                                <NumberBox
                                                    Header="{Binding CpuShortLabel}"
                                                    Text="{Binding CpuThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    Value="20"
                                                    SpinButtonPlacementMode="Inline"
                                                    SmallChange="5"
                                                    LargeChange="20"
                                                    ValidationMode="InvalidInputOverwritten"
                                                    HorizontalAlignment="Stretch"
                                                    Visibility="{Binding IsCpu, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    Style="{StaticResource GlassNumberBoxStyle}" />

                                                <NumberBox
                                                    Header="{Binding BatteryShortLabel}"
                                                    Text="{Binding BatteryThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    Value="20"
                                                    SpinButtonPlacementMode="Inline"
                                                    SmallChange="5"
                                                    LargeChange="10"
                                                    ValidationMode="InvalidInputOverwritten"
                                                    HorizontalAlignment="Stretch"
                                                    Visibility="{Binding IsBattery, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    Style="{StaticResource GlassNumberBoxStyle}" />

                                                <StackPanel
                                                    Spacing="12"
                                                    Visibility="{Binding IsAppIdle, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <Grid ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <ComboBox
                                                            Header="{Binding AppIdleAppLabel}"
                                                            ItemsSource="{Binding AppTargets}"
                                                            DisplayMemberPath="Label"
                                                            SelectedItem="{Binding SelectedAppTarget, Mode=TwoWay}"
                                                            AutomationProperties.Name="{Binding AppIdleAppLabel}"
                                                            HorizontalAlignment="Stretch" />
                                                        <Button
                                                            Grid.Column="1"
                                                            Click="OnRefreshCloseAppTargetsClick"
                                                            VerticalAlignment="Bottom"
                                                            ToolTipService.ToolTip="{Binding RefreshAppsLabel}"
                                                            AutomationProperties.Name="{Binding RefreshAppsLabel}"
                                                            Width="36"
                                                            Height="36"
                                                            Padding="0"
                                                            Style="{StaticResource GlassSecondaryButtonStyle}">
                                                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                                        </Button>
                                                    </Grid>
                                                    <NumberBox
                                                        Header="{Binding AppIdleMinutesLabel}"
                                                        Text="{Binding AppIdleMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        Value="5"
                                                        Minimum="1"
                                                        Maximum="1440"
                                                        SpinButtonPlacementMode="Inline"
                                                        SmallChange="1"
                                                        LargeChange="5"
                                                        ValidationMode="InvalidInputOverwritten"
                                                        HorizontalAlignment="Stretch"
                                                        Style="{StaticResource GlassNumberBoxStyle}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Widget: floating countdown settings. -->
                <Border
                    x:Name="SectionRegion3"
                    Grid.Column="2"
                    Style="{StaticResource GlassSectionContainerStyle}">
                    <ScrollViewer
                        HorizontalScrollBarVisibility="Disabled"
                        HorizontalScrollMode="Disabled"
                        VerticalScrollBarVisibility="Auto"
                        VerticalScrollMode="Enabled">
                        <StackPanel Spacing="16">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource SectionIconTileStyle}">
                                    <FontIcon Glyph="&#xE737;" Style="{StaticResource SectionIconStyle}" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding WidgetLabel}" Style="{StaticResource SectionHeadingTextStyle}" />
                                    <TextBlock Text="{Binding Loc[WidgetHint]}" Style="{StaticResource SectionCaptionTextStyle}" />
                                </StackPanel>
                            </Grid>

                            <Border Style="{StaticResource FieldGroupStyle}" Padding="14,2">
                                <StackPanel>
                                    <Grid Style="{StaticResource ToggleRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Loc[EnableWidget]}" Style="{StaticResource FormRowLabelStyle}" />
                                        <ToggleSwitch
                                            Grid.Column="1"
                                            IsOn="{Binding WidgetEnabled, Mode=TwoWay}"
                                            TabIndex="40"
                                            AutomationProperties.Name="{Binding Loc[EnableWidget]}"
                                            Style="{StaticResource FormToggleSwitchStyle}" />
                                    </Grid>
                                    <Border Style="{StaticResource SectionDividerStyle}" />
                                    <Grid Style="{StaticResource ToggleRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding ShowOnAllScreensLabel}" Style="{StaticResource FormRowLabelStyle}" />
                                        <ToggleSwitch
                                            Grid.Column="1"
                                            IsOn="{Binding WidgetShowOnAllScreens, Mode=TwoWay}"
                                            TabIndex="41"
                                            AutomationProperties.Name="{Binding ShowOnAllScreensLabel}"
                                            Style="{StaticResource FormToggleSwitchStyle}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <StackPanel Spacing="12">
                                <ComboBox
                                    Header="{Binding Loc[WidgetMode]}"
                                    ItemsSource="{Binding WidgetModes}"
                                    DisplayMemberPath="Label"
                                    SelectedItem="{Binding SelectedWidgetMode, Mode=TwoWay}"
                                    TabIndex="42"
                                    AutomationProperties.Name="{Binding Loc[WidgetMode]}"
                                    HorizontalAlignment="Stretch" />
                                <ComboBox
                                    Header="{Binding WidgetSizeLabel}"
                                    ItemsSource="{Binding WidgetSizePresets}"
                                    DisplayMemberPath="Label"
                                    SelectedItem="{Binding SelectedWidgetSizePreset, Mode=TwoWay}"
                                    TabIndex="43"
                                    AutomationProperties.Name="{Binding WidgetSizeLabel}"
                                    HorizontalAlignment="Stretch" />
                                <ComboBox
                                    Header="{Binding WidgetPositionLabel}"
                                    ItemsSource="{Binding WidgetAnchors}"
                                    DisplayMemberPath="Label"
                                    SelectedItem="{Binding SelectedWidgetAnchor, Mode=TwoWay}"
                                    TabIndex="44"
                                    AutomationProperties.Name="{Binding WidgetPositionLabel}"
                                    HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
        </Grid>
        </ScrollViewer>

        <TextBlock
            x:Name="AccessibilityStatusText"
            Visibility="Collapsed"
            AutomationProperties.LiveSetting="Polite" />
        </Grid>
    </Grid>
</Window>
