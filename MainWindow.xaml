<Window x:Class="Shutdown_Scheduler.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Shutdown_Scheduler.Controls"
        Title="{Binding AppTitle}" Height="760" Width="1040" MinHeight="640" MinWidth="880"
        Background="{DynamicResource AppBg}" FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen" WindowStyle="SingleBorderWindow" ResizeMode="CanResize">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#0B1726"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#1C3F63"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#1C3F63"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#0D1A2A"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#EDF4FF"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#EDF4FF"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#EDF4FF"/>

        <SolidColorBrush x:Key="AppBg" Color="#07111D"/>
        <SolidColorBrush x:Key="Surface" Color="#102033" Opacity="0.9"/>
        <SolidColorBrush x:Key="SurfaceDeep" Color="#0B1726" Opacity="0.95"/>
        <SolidColorBrush x:Key="Stroke" Color="#7CB9E8" Opacity="0.30"/>
        <SolidColorBrush x:Key="StrokeStrong" Color="#6EC1FF" Opacity="0.75"/>
        <SolidColorBrush x:Key="Text" Color="#EDF4FF"/>
        <SolidColorBrush x:Key="TextDim" Color="#B5C8DE"/>
        <SolidColorBrush x:Key="TextFaint" Color="#8EA8C3"/>
        <SolidColorBrush x:Key="Accent" Color="#58B6FF"/>
        <SolidColorBrush x:Key="AccentSoft" Color="#58B6FF" Opacity="0.15"/>

        <LinearGradientBrush x:Key="CardGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#11233A" Offset="0"/>
            <GradientStop Color="#0D1A2A" Offset="1"/>
        </LinearGradientBrush>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardGradient}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Stroke}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="40"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="ChromeLessToggle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource SurfaceDeep}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Stroke}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="TextBoxBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TextBoxBorder" Property="Background" Value="#0E2034"/>
                                <Setter TargetName="TextBoxBorder" Property="BorderBrush" Value="{StaticResource StrokeStrong}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TextBoxBorder" Property="Background" Value="#0E2034"/>
                                <Setter TargetName="TextBoxBorder" Property="BorderBrush" Value="{StaticResource StrokeStrong}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="TextBoxBorder" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource SurfaceDeep}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Stroke}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="MainBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6"/>
                            <Grid Margin="{TemplateBinding Padding}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="24"/>
                                </Grid.ColumnDefinitions>

                                <ContentPresenter x:Name="ContentSite"
                                                  Grid.Column="0"
                                                  Margin="0"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Left"
                                                  RecognizesAccessKey="True"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>

                                <Path x:Name="Arrow"
                                      Grid.Column="1"
                                      Width="10"
                                      Height="6"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Center"
                                      Fill="Transparent"
                                      Stroke="{StaticResource TextDim}"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Data="M 1 1 L 5 5 L 9 1"/>
                            </Grid>

                            <ToggleButton Grid.ColumnSpan="2"
                                          Style="{StaticResource ChromeLessToggle}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"/>

                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Fade">
                                <Border Margin="0,4,0,0"
                                        Background="{StaticResource SurfaceDeep}"
                                        BorderBrush="{StaticResource StrokeStrong}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="{StaticResource StrokeStrong}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MainBorder" Property="Background" Value="#0E2034"/>
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="{StaticResource StrokeStrong}"/>
                                <Setter TargetName="Arrow" Property="Stroke" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="MainBorder" Property="Background" Value="#0E2034"/>
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="{StaticResource StrokeStrong}"/>
                                <Setter TargetName="Arrow" Property="Stroke" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="MainBorder" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="{StaticResource SurfaceDeep}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="ItemContent"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#1A3552"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#234A72"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsHighlighted" Value="True"/>
                                    <Condition Property="IsSelected" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="ItemBorder" Property="Background" Value="#2B5C8E"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#8EA8C3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,6"/>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
        </Style>

        <Style x:Key="SwitchToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="MinWidth" Value="112"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track"
                                Background="{StaticResource SurfaceDeep}"
                                BorderBrush="{StaticResource Stroke}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border x:Name="Knob"
                                        Grid.Column="0"
                                        Margin="3"
                                        Background="#13283D"
                                        BorderBrush="{StaticResource StrokeStrong}"
                                        BorderThickness="1"
                                        CornerRadius="5"/>

                                <TextBlock Grid.Column="0"
                                           Text="{TemplateBinding Content}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Text="{TemplateBinding Tag}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#0E2034"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource StrokeStrong}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Knob" Property="Grid.Column" Value="0"/>
                                <Setter TargetName="Knob" Property="Background" Value="#153A5A"/>
                                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="Knob" Property="Grid.Column" Value="1"/>
                                <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Track" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SegmentToggleShell" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceDeep}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Stroke}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="MinHeight" Value="36"/>
        </Style>

        <Style x:Key="SegmentToggleOption" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="OptionBorder"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="5"
                                Margin="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OptionBorder" Property="Background" Value="#0E2034"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="OptionBorder" Property="Background" Value="#153A5A"/>
                                <Setter TargetName="OptionBorder" Property="BorderBrush" Value="{StaticResource StrokeStrong}"/>
                                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="OptionBorder" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

                <Style x:Key="SettingToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="50"/>
                            </Grid.ColumnDefinitions>

                            <ContentPresenter Grid.Column="0"
                                              Content="{TemplateBinding Content}"
                                              ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>

                            <Border x:Name="Track"
                                    Grid.Column="1"
                                    Width="42"
                                    Height="22"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource SurfaceDeep}"
                                    BorderBrush="{StaticResource Stroke}"
                                    BorderThickness="1"
                                    CornerRadius="11">
                                <Ellipse x:Name="Thumb"
                                         Width="16"
                                         Height="16"
                                         Fill="{StaticResource TextFaint}"
                                         HorizontalAlignment="Left"
                                         Margin="3,0,0,0"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource StrokeStrong}"/>
                                <Setter TargetName="Track" Property="Background" Value="#0E2034"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#153A5A"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource StrokeStrong}"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SurfaceDeep}"/>
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="BorderBrush" Value="{StaticResource StrokeStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#122A42"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource StrokeStrong}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#0D2236"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Stroke}"/>
            <Setter Property="Background" Value="#13283D"/>
        </Style>

        <Style x:Key="ChromeButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinWidth" Value="34"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="FontSize" Value="15"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#203249"/>
                    <Setter Property="BorderBrush" Value="{StaticResource Stroke}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource AppBg}" BorderBrush="{StaticResource Stroke}" BorderThickness="1">
        <Viewbox Stretch="Uniform" StretchDirection="Both">
            <Grid Width="1040" Height="760" Background="{StaticResource AppBg}">
                <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14">
                        <StackPanel>
                            <TextBlock Text="Action" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.3*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="1.3*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Action to execute" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding Actions}" SelectedItem="{Binding SelectedAction}" DisplayMemberPath="Label"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Visibility="{Binding IsForcedModeAvailable, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding ForceAdminLabel}" Style="{StaticResource FieldLabel}"/>
                                    <Border Style="{StaticResource SegmentToggleShell}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <RadioButton Grid.Column="0"
                                                         GroupName="ForceAdminMode"
                                                         Content="{Binding YesLabel}"
                                                         Style="{StaticResource SegmentToggleOption}"
                                                         IsChecked="{Binding IsForcedAdmin, Mode=TwoWay}"/>
                                            <RadioButton Grid.Column="1"
                                                         GroupName="ForceAdminMode"
                                                         Content="{Binding NoLabel}"
                                                         Style="{StaticResource SegmentToggleOption}"
                                                         IsChecked="{Binding IsNormalExecution, Mode=TwoWay}"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.3*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="1.3*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding TargetTimeLabel}" Style="{StaticResource FieldLabel}"/>
                                    <controls:DateTimePicker Value="{Binding SelectedTargetDateTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             Minimum="{Binding MinimumTargetDateTime}"
                                                             Maximum="{Binding MaximumTargetDateTime}"
                                                             DisplayFormat="hh:mm tt"
                                                             MinuteStep="5"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Current time + minutes" Style="{StaticResource FieldLabel}"/>
                                    <DockPanel LastChildFill="False">
                                        <TextBox Text="{Binding RelativeMinutes, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                                        <TextBlock Text="min" Foreground="{StaticResource TextDim}" FontSize="17" Margin="10,8,0,0"/>
                                    </DockPanel>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12">
                        <StackPanel>
                            <TextBlock Text="Conditions" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="All enabled conditions must be true to execute the action." Foreground="{StaticResource TextDim}" FontSize="13" Margin="0,2,0,8"/>

                            <Border Background="#0D1A2A" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="8" Padding="7" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="92"/>
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton Grid.Column="0" Content="{Binding Loc[NetworkBelow]}" IsChecked="{Binding NetworkConditionEnabled}" Style="{StaticResource SettingToggle}" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Text="{Binding NetworkThreshold, UpdateSourceTrigger=PropertyChanged}" Margin="8,0"/>
                                    <ComboBox Grid.Column="2" ItemsSource="{Binding NetworkUnits}" SelectedItem="{Binding SelectedNetworkUnit}" DisplayMemberPath="Label"/>
                                </Grid>
                            </Border>

                            <Border Background="#0D1A2A" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="8" Padding="7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="92"/>
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton Grid.Column="0" Content="{Binding Loc[CpuBelow]}" IsChecked="{Binding CpuConditionEnabled}" Style="{StaticResource SettingToggle}" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Text="{Binding CpuThreshold, UpdateSourceTrigger=PropertyChanged}" Margin="8,0"/>
                                    <TextBlock Grid.Column="2"
                                               Text="%"
                                               FontSize="14"
                                               Foreground="{StaticResource Text}"
                                               TextAlignment="Center"
                                               HorizontalAlignment="Stretch"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12" Margin="0">
                            <StackPanel>
                                <TextBlock Text="Widget" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Loc[EnableWidget]}"
                                               Foreground="{StaticResource TextDim}"
                                               FontSize="13"
                                               VerticalAlignment="Center"/>

                                    <Grid Grid.Column="1">
                                        <ToggleButton x:Name="WidgetSettingsButton"
                                                      Content="Widget settings"
                                                      Background="#13283D"
                                                      Foreground="{StaticResource Text}"
                                                      BorderBrush="{StaticResource Stroke}"
                                                      BorderThickness="1"
                                                      Padding="10,6"
                                                      FontSize="13"
                                                      FontWeight="SemiBold"
                                                      Cursor="Hand"
                                                      MinHeight="30"/>

                                        <Popup Placement="Bottom"
                                               PlacementTarget="{Binding ElementName=WidgetSettingsButton}"
                                               StaysOpen="False"
                                               AllowsTransparency="True"
                                               IsOpen="{Binding IsChecked, ElementName=WidgetSettingsButton, Mode=TwoWay}">
                                            <Border Margin="0,6,0,0"
                                                    Background="{StaticResource SurfaceDeep}"
                                                    BorderBrush="{StaticResource StrokeStrong}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="12"
                                                    MinWidth="280">
                                                <StackPanel>
                                                    <TextBlock Text="Widget settings"
                                                               Style="{StaticResource SectionTitle}"
                                                               FontSize="15"
                                                               Margin="0,0,0,8"/>

                                                    <ToggleButton Content="{Binding Loc[EnableWidget]}"
                                                                  IsChecked="{Binding WidgetEnabled}"
                                                                  Style="{StaticResource SettingToggle}"
                                                                  Margin="0,0,0,6"/>

                                                    <ToggleButton Content="{Binding ShowOnAllScreensLabel}"
                                                                  IsChecked="{Binding WidgetShowOnAllScreens}"
                                                                  Style="{StaticResource SettingToggle}"
                                                                  Margin="0,0,0,8"/>

                                                    <TextBlock Text="{Binding WidgetSizeLabel}"
                                                               Style="{StaticResource FieldLabel}"/>
                                                    <ComboBox ItemsSource="{Binding WidgetSizePresets}"
                                                              SelectedItem="{Binding SelectedWidgetSizePreset}"
                                                              DisplayMemberPath="Label"
                                                              Margin="0,0,0,8"/>

                                                    <TextBlock Text="{Binding WidgetPositionLabel}"
                                                               Style="{StaticResource FieldLabel}"/>
                                                    <ComboBox ItemsSource="{Binding WidgetAnchors}"
                                                              SelectedItem="{Binding SelectedWidgetAnchor}"
                                                              DisplayMemberPath="Label"/>
                                                </StackPanel>
                                            </Border>
                                        </Popup>
                                    </Grid>
                                </Grid>

                                <Border Margin="0,8,0,0" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="8" Padding="8" Background="#0B1726" MinHeight="96">
                                    <StackPanel>
                                        <TextBlock Text="SHUTDOWN" Foreground="{StaticResource Accent}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding TargetTime}" Foreground="{StaticResource Accent}" FontSize="30" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding RelativeMinutes, StringFormat={}{0} min 00 sec}" Foreground="{StaticResource Accent}" FontSize="12" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12" Margin="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="Summary" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>

                                <Grid Grid.Row="1" Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="52"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Action:" Foreground="{StaticResource TextDim}" FontSize="14"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedAction.Label}" FontSize="16"/>
                                </Grid>

                                <Grid Grid.Row="2" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="52"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Time:" Foreground="{StaticResource TextDim}" FontSize="14"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ActiveSummary}" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" FontSize="13"/>
                                </Grid>

                                <Grid Grid.Row="3" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="52"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="State:" Foreground="{StaticResource TextDim}" FontSize="14"/>
                                    <TextBlock Grid.Column="1" Text="{Binding StatusSummary}" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" FontSize="13"/>
                                </Grid>

                                <Button Grid.Row="4" Command="{Binding ScheduleCommand}" MinHeight="36">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text=">" Foreground="{StaticResource Accent}" FontSize="15" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding ProgramLabel}" Foreground="{StaticResource Accent}" FontSize="18" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Viewbox>
    </Border>
</Window>

