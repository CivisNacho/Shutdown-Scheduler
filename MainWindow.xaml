<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Shutdown_Scheduler_WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid
        x:Name="Root"
        Padding="12"
        RowSpacing="8"
        Background="{ThemeResource AppChromeBackgroundBrush}"
        UseSystemFocusVisuals="True">
        <Grid
            x:Name="DesignSurface"
            Background="{ThemeResource AppChromeBackgroundBrush}"
            UseSystemFocusVisuals="True">
        <Grid.Resources>
            <DataTemplate x:Key="AppTargetTemplate">
                <Grid ColumnSpacing="10" MinHeight="28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Width="20"
                        Height="20"
                        CornerRadius="6"
                        Background="{ThemeResource GlassPanelSecondaryBackgroundBrush}"
                        BorderBrush="{ThemeResource GlassPanelBorderBrush}"
                        BorderThickness="1"
                        VerticalAlignment="Center">
                        <Grid>
                            <FontIcon
                                Glyph="&#xE8D7;"
                                FontSize="12"
                                Foreground="{ThemeResource MutedTextBrush}"
                                Visibility="{Binding IsIconLoaded, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                            <Image
                                Width="16"
                                Height="16"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Source="{Binding Icon}"
                                Visibility="{Binding IsIconLoaded, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Stretch="Uniform" />
                        </Grid>
                    </Border>
                    <TextBlock
                        Grid.Column="1"
                        Text="{Binding Label}"
                        VerticalAlignment="Center"
                        TextTrimming="CharacterEllipsis" />
                </Grid>
            </DataTemplate>

            <Style x:Key="HeaderMetaTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource HeroCaptionBrush}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="TextWrapping" Value="NoWrap" />
            </Style>

            <Style x:Key="InlineLabelTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource MutedTextBrush}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="CharacterSpacing" Value="40" />
            </Style>

            <Style x:Key="GlassInsetPanelStyle" TargetType="Border">
                <Setter Property="Padding" Value="8" />
                <Setter Property="CornerRadius" Value="{ThemeResource AppInnerCornerRadius}" />
                <Setter Property="Background" Value="{ThemeResource GlassPanelInsetBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource GlassPanelBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="MainSectionsGrid.ColumnDefinitions[0].Width" Value="*" />
                        <Setter Target="MainSectionsGrid.ColumnDefinitions[1].Width" Value="0" />
                        <Setter Target="MainSectionsGrid.ColumnDefinitions[2].Width" Value="0" />
                        <Setter Target="MainSectionsGrid.RowDefinitions[0].Height" Value="Auto" />
                        <Setter Target="MainSectionsGrid.RowDefinitions[1].Height" Value="Auto" />
                        <Setter Target="MainSectionsGrid.RowDefinitions[2].Height" Value="Auto" />
                        <Setter Target="SectionRegion2.(Grid.Column)" Value="0" />
                        <Setter Target="SectionRegion3.(Grid.Column)" Value="0" />
                        <Setter Target="SectionRegion2.(Grid.Row)" Value="1" />
                        <Setter Target="SectionRegion3.(Grid.Row)" Value="2" />
                        <Setter Target="SectionRegion3.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="HeaderActionsHost.(Grid.Row)" Value="1" />
                        <Setter Target="HeaderActionsHost.(Grid.Column)" Value="0" />
                    </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="MediumState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="860" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="MainSectionsGrid.ColumnDefinitions[0].Width" Value="*" />
                        <Setter Target="MainSectionsGrid.ColumnDefinitions[1].Width" Value="*" />
                        <Setter Target="MainSectionsGrid.ColumnDefinitions[2].Width" Value="0" />
                        <Setter Target="MainSectionsGrid.RowDefinitions[0].Height" Value="*" />
                        <Setter Target="MainSectionsGrid.RowDefinitions[1].Height" Value="Auto" />
                        <Setter Target="MainSectionsGrid.RowDefinitions[2].Height" Value="0" />
                        <Setter Target="SectionRegion2.(Grid.Column)" Value="1" />
                        <Setter Target="SectionRegion3.(Grid.Column)" Value="0" />
                        <Setter Target="SectionRegion2.(Grid.Row)" Value="0" />
                        <Setter Target="SectionRegion3.(Grid.Row)" Value="1" />
                        <Setter Target="SectionRegion3.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="HeaderActionsHost.(Grid.Row)" Value="0" />
                        <Setter Target="HeaderActionsHost.(Grid.Column)" Value="1" />
                    </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1280" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="MainSectionsGrid.ColumnDefinitions[0].Width" Value="*" />
                        <Setter Target="MainSectionsGrid.ColumnDefinitions[1].Width" Value="*" />
                        <Setter Target="MainSectionsGrid.ColumnDefinitions[2].Width" Value="*" />
                        <Setter Target="MainSectionsGrid.RowDefinitions[0].Height" Value="*" />
                        <Setter Target="MainSectionsGrid.RowDefinitions[1].Height" Value="0" />
                        <Setter Target="MainSectionsGrid.RowDefinitions[2].Height" Value="0" />
                        <Setter Target="SectionRegion2.(Grid.Column)" Value="1" />
                        <Setter Target="SectionRegion3.(Grid.Column)" Value="2" />
                        <Setter Target="SectionRegion2.(Grid.Row)" Value="0" />
                        <Setter Target="SectionRegion3.(Grid.Row)" Value="0" />
                        <Setter Target="SectionRegion3.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="HeaderActionsHost.(Grid.Row)" Value="0" />
                        <Setter Target="HeaderActionsHost.(Grid.Column)" Value="1" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Border
            Padding="14,10,14,12"
            Background="{ThemeResource WindowHeroBackgroundBrush}"
            BorderBrush="{ThemeResource WindowHeroBorderBrush}"
            BorderThickness="1"
            CornerRadius="{ThemeResource AppCornerRadius}">
            <Grid ColumnSpacing="14" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="6">
                    <TextBlock
                        Text="{Binding AppTitle}"
                        Style="{StaticResource InlineLabelTextStyle}"
                        Foreground="{ThemeResource HeroEyebrowBrush}" />
                    <Grid ColumnSpacing="14" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Text="{Binding Remaining}"
                            FontFamily="Consolas"
                            FontStyle="Italic"
                            FontSize="32"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource HeroValueBrush}" />
                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <TextBlock
                                Text="{Binding ActiveSummary}"
                                FontFamily="Consolas"
                                FontSize="20"
                                FontStyle="Italic"
                                MaxLines="1"
                                Style="{StaticResource HeaderMetaTextStyle}"
                                Foreground="{ThemeResource HeroValueBrush}"
                                ToolTipService.ToolTip="{Binding ActiveSummary}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <Grid
                    x:Name="HeaderActionsHost"
                    Grid.Column="1"
                    ColumnSpacing="6"
                    VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button
                        x:Name="ScheduleButton"
                        Content="{Binding ScheduleButtonLabel}"
                        Command="{Binding ScheduleCommand}"
                        AccessKey="S"
                        TabIndex="10"
                        AutomationProperties.Name="{Binding ScheduleButtonLabel}"
                        AutomationProperties.HelpText="Create or replace the current schedule."
                        MinWidth="136"
                        Style="{ThemeResource GlassPrimaryButtonStyle}" />
                    <Button
                        x:Name="CancelScheduleButton"
                        Grid.Column="1"
                        Content="{Binding CancelButtonLabel}"
                        Command="{Binding CancelCommand}"
                        IsEnabled="{Binding HasActiveSchedule}"
                        AccessKey="C"
                        TabIndex="11"
                        AutomationProperties.Name="{Binding CancelButtonLabel}"
                        AutomationProperties.HelpText="Cancel the active schedule."
                        MinWidth="100"
                        Style="{ThemeResource GlassSecondaryButtonStyle}" />
                </Grid>

                <Border
                    Grid.Row="1"
                    Grid.ColumnSpan="2"
                    Height="1"
                    Style="{ThemeResource SectionDividerStyle}" />
            </Grid>
        </Border>

        <Grid
            Grid.Row="1"
            x:Name="MainSectionsGrid"
            ColumnSpacing="10"
            RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="0" />
                    <RowDefinition Height="0" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Border Style="{ThemeResource GlassSectionContainerStyle}">
                    <ScrollViewer
                        HorizontalScrollBarVisibility="Disabled"
                        HorizontalScrollMode="Disabled"
                        VerticalScrollBarVisibility="Auto"
                        VerticalScrollMode="Enabled">
                        <Grid RowSpacing="10" MinWidth="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="1" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="{Binding ScheduleLabel}" Style="{ThemeResource SectionHeadingTextStyle}" />
                            <Border Grid.Row="1" Style="{ThemeResource SectionDividerStyle}" />

                            <ComboBox
                                Grid.Row="2"
                                Header="{Binding ActionLabel}"
                                ItemsSource="{Binding Actions}"
                                DisplayMemberPath="Label"
                                SelectedItem="{Binding SelectedAction, Mode=TwoWay}"
                                TabIndex="20"
                                AutomationProperties.Name="{Binding ActionLabel}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Top" />

                            <Border
                                Grid.Row="3"
                                Style="{StaticResource GlassInsetPanelStyle}"
                                Visibility="{Binding IsForcedModeAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid MinHeight="32" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox
                                        Content="{Binding ForceAdminLabel}"
                                        IsChecked="{Binding IsForcedAdmin, Mode=TwoWay}"
                                        TabIndex="21"
                                        AutomationProperties.Name="{Binding ForceAdminLabel}"
                                        VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <Border
                                Grid.Row="4"
                                Style="{StaticResource GlassInsetPanelStyle}"
                                Visibility="{Binding IsCloseAppAction, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid x:Name="CloseAppPickerPanel" RowSpacing="6">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Text="{Binding AppToCloseLabel}"
                                            Style="{ThemeResource FormRowLabelStyle}"
                                            VerticalAlignment="Center" />
                                        <Button
                                            Grid.Column="1"
                                            Content="{Binding RefreshAppsLabel}"
                                            Click="OnRefreshCloseAppTargetsClick"
                                            AccessKey="R"
                                            TabIndex="22"
                                            AutomationProperties.Name="{Binding RefreshAppsLabel}"
                                            AutomationProperties.HelpText="Refresh the list of running apps."
                                            Style="{ThemeResource GlassSecondaryButtonStyle}" />
                                    </Grid>
                                    <ComboBox
                                        Grid.Row="1"
                                        ItemsSource="{Binding Items}"
                                        ItemTemplate="{StaticResource AppTargetTemplate}"
                                        SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                        PlaceholderText="{Binding NoAppsFoundLabel}"
                                        TabIndex="23"
                                        AutomationProperties.Name="{Binding AppToCloseLabel}"
                                        AutomationProperties.HelpText="Choose the running app that will be closed."
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Top" />
                                    <Grid Grid.Row="2" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ProgressRing
                                            Width="16"
                                            Height="16"
                                            IsActive="{Binding IsLoading}"
                                            Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            VerticalAlignment="Center" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Text="{Binding LoadingAppsLabel}"
                                            Foreground="{ThemeResource MutedTextBrush}"
                                            Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            VerticalAlignment="Center" />
                                        <TextBlock
                                            Grid.Column="2"
                                            Margin="8,0,0,0"
                                            Text="{Binding NoAppsFoundLabel}"
                                            Foreground="{ThemeResource MutedTextBrush}"
                                            Visibility="{Binding HasNoItems, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            VerticalAlignment="Center" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border Grid.Row="5" Style="{StaticResource GlassInsetPanelStyle}">
                                <Grid ColumnSpacing="8" RowSpacing="6">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="{Binding DateLabel}" Style="{StaticResource InlineLabelTextStyle}" />
                                    <CalendarDatePicker
                                        x:Name="TargetDatePicker"
                                        Grid.Row="1"
                                        PlaceholderText="{Binding PickDatePlaceholder}"
                                        DateChanged="OnTargetDateChanged"
                                        TabIndex="24"
                                        AutomationProperties.Name="{Binding DateLabel}"
                                        MinHeight="40"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Top" />
                                    <TextBlock
                                        Grid.Row="2"
                                        Text="{Binding TargetTimeLabel}"
                                        Style="{StaticResource InlineLabelTextStyle}" />
                                    <TimePicker
                                        x:Name="TargetTimePicker"
                                        Grid.Row="3"
                                        TimeChanged="OnTargetTimeChanged"
                                        TabIndex="25"
                                        AutomationProperties.Name="{Binding TargetTimeLabel}"
                                        MinHeight="40"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Top" />
                                </Grid>
                            </Border>

                            <Border Grid.Row="6" Style="{StaticResource GlassInsetPanelStyle}">
                                <Grid ColumnSpacing="12" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="150" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Text="{Binding MinutesFromNowLabel}"
                                        Style="{ThemeResource FormRowLabelStyle}"
                                        VerticalAlignment="Center"
                                        TextWrapping="WrapWholeWords" />
                                    <NumberBox
                                        x:Name="RelativeMinutesNumberBox"
                                        Grid.Column="1"
                                        Text="{Binding RelativeMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Minimum="1"
                                        Value="15"
                                        SpinButtonPlacementMode="Inline"
                                        TabIndex="26"
                                        AutomationProperties.Name="{Binding MinutesFromNowLabel}"
                                        SmallChange="1"
                                        LargeChange="60"
                                        ValidationMode="InvalidInputOverwritten"
                                        ValueChanged="OnRelativeMinutesValueChanged" />
                                </Grid>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </Border>

                <Border
                    x:Name="SectionRegion2"
                    Grid.Column="1"
                    Style="{ThemeResource GlassSectionContainerStyle}">
                    <Grid RowSpacing="10" MinWidth="0" MinHeight="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="1" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="{Binding ConditionsLabel}" Style="{ThemeResource SectionHeadingTextStyle}" />
                        <Border Grid.Row="1" Style="{ThemeResource SectionDividerStyle}" />

                        <Grid Grid.Row="2">
                            <Button
                                Content="{Binding AddConditionLabel}"
                                MinWidth="144"
                                HorizontalAlignment="Left"
                                Click="OnAddConditionClick"
                                AccessKey="A"
                                TabIndex="30"
                                AutomationProperties.Name="{Binding AddConditionLabel}"
                                Style="{ThemeResource GlassSecondaryButtonStyle}" />
                        </Grid>

                        <TextBlock
                            Grid.Row="3"
                            Text="{Binding NoConditionsLabel}"
                            Foreground="{ThemeResource MutedTextBrush}"
                            Visibility="{Binding HasNoConditions, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <ListView
                            Grid.Row="3"
                            ItemsSource="{Binding Conditions}"
                            SelectionMode="None"
                            IsItemClickEnabled="False"
                            Padding="6"
                            MinHeight="0"
                            VerticalAlignment="Stretch"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            ScrollViewer.VerticalScrollMode="Enabled"
                            Visibility="{Binding HasConditions, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Style="{ThemeResource GlassListViewStyle}">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Margin="0,0,0,8"
                                        Padding="10"
                                        CornerRadius="{ThemeResource AppInnerCornerRadius}"
                                        Background="{ThemeResource GlassPanelSecondaryBackgroundBrush}"
                                        BorderBrush="{ThemeResource GlassPanelBorderBrush}"
                                        BorderThickness="1">
                                        <Grid RowSpacing="10">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid ColumnSpacing="10" MinHeight="36">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}" Style="{ThemeResource FormRowLabelStyle}" />
                                                <Button
                                                    Grid.Column="1"
                                                    Content="{Binding RemoveConditionLabel}"
                                                    Click="OnRemoveConditionClick"
                                                    TabIndex="31"
                                                    AutomationProperties.Name="{Binding RemoveConditionLabel}"
                                                    Style="{ThemeResource GlassSecondaryButtonStyle}" />
                                            </Grid>

                                            <Grid
                                                Grid.Row="1"
                                                ColumnSpacing="8"
                                                Visibility="{Binding IsNetwork, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="152" />
                                                </Grid.ColumnDefinitions>
                                                <NumberBox
                                                    Header="{Binding RequiredBelowLabel}"
                                                    Text="{Binding NetworkThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    ValidationMode="InvalidInputOverwritten"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Top" />
                                                <ComboBox
                                                    Grid.Column="1"
                                                    Header="{Binding NetworkShortLabel}"
                                                    ItemsSource="{Binding NetworkUnits}"
                                                    DisplayMemberPath="Label"
                                                    SelectedItem="{Binding SelectedNetworkUnit, Mode=TwoWay}"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Top" />
                                            </Grid>

                                            <NumberBox
                                                Grid.Row="2"
                                                Header="{Binding CpuShortLabel}"
                                                Text="{Binding CpuThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Value="20"
                                                SpinButtonPlacementMode="Inline"
                                                SmallChange="5"
                                                LargeChange="20"
                                                ValidationMode="InvalidInputOverwritten"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Top"
                                                Visibility="{Binding IsCpu, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                Style="{ThemeResource GlassNumberBoxStyle}" />

                                            <NumberBox
                                                Grid.Row="3"
                                                Header="{Binding BatteryShortLabel}"
                                                Text="{Binding BatteryThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Value="20"
                                                SpinButtonPlacementMode="Inline"
                                                SmallChange="5"
                                                LargeChange="10"
                                                ValidationMode="InvalidInputOverwritten"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Top"
                                                Visibility="{Binding IsBattery, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                Style="{ThemeResource GlassNumberBoxStyle}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <Border
                    x:Name="SectionRegion3"
                    Grid.Column="2"
                    Style="{ThemeResource GlassSectionContainerStyle}">
                    <Grid RowSpacing="10" MinWidth="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="1" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="{Binding WidgetLabel}" Style="{ThemeResource SectionHeadingTextStyle}" />
                        <Border Grid.Row="1" Style="{ThemeResource SectionDividerStyle}" />

                        <Border Grid.Row="2" Style="{StaticResource GlassInsetPanelStyle}">
                            <Grid MinHeight="32" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="72" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Loc[EnableWidget]}" Style="{ThemeResource FormRowLabelStyle}" />
                                <ToggleSwitch
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    IsOn="{Binding WidgetEnabled, Mode=TwoWay}"
                                    OffContent=""
                                    OnContent=""
                                    TabIndex="40"
                                    AutomationProperties.Name="{Binding Loc[EnableWidget]}"
                                    Style="{ThemeResource FormToggleSwitchStyle}" />
                            </Grid>
                        </Border>

                        <Border Grid.Row="3" Style="{StaticResource GlassInsetPanelStyle}">
                            <Grid MinHeight="32" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="72" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding ShowOnAllScreensLabel}" Style="{ThemeResource FormRowLabelStyle}" />
                                <ToggleSwitch
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    IsOn="{Binding WidgetShowOnAllScreens, Mode=TwoWay}"
                                    OffContent=""
                                    OnContent=""
                                    TabIndex="41"
                                    AutomationProperties.Name="{Binding ShowOnAllScreensLabel}"
                                    Style="{ThemeResource FormToggleSwitchStyle}" />
                            </Grid>
                        </Border>

                        <ComboBox
                            Grid.Row="4"
                            Header="{Binding Loc[WidgetMode]}"
                            ItemsSource="{Binding WidgetModes}"
                            DisplayMemberPath="Label"
                            SelectedItem="{Binding SelectedWidgetMode, Mode=TwoWay}"
                            TabIndex="42"
                            AutomationProperties.Name="{Binding Loc[WidgetMode]}"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Top" />
                        <ComboBox
                            Grid.Row="5"
                            Header="{Binding WidgetSizeLabel}"
                            ItemsSource="{Binding WidgetSizePresets}"
                            DisplayMemberPath="Label"
                            SelectedItem="{Binding SelectedWidgetSizePreset, Mode=TwoWay}"
                            TabIndex="43"
                            AutomationProperties.Name="{Binding WidgetSizeLabel}"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Top" />
                        <ComboBox
                            Grid.Row="6"
                            Header="{Binding WidgetPositionLabel}"
                            ItemsSource="{Binding WidgetAnchors}"
                            DisplayMemberPath="Label"
                            SelectedItem="{Binding SelectedWidgetAnchor, Mode=TwoWay}"
                            TabIndex="44"
                            AutomationProperties.Name="{Binding WidgetPositionLabel}"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Top" />
                    </Grid>
                </Border>
        </Grid>

        <TextBlock
            x:Name="AccessibilityStatusText"
            Visibility="Collapsed"
            AutomationProperties.LiveSetting="Polite" />
        </Grid>
    </Grid>
</Window>
