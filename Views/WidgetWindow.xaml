<Window x:Class="Shutdown_Scheduler.Views.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False"
        AllowsTransparency="True" Background="Transparent"
        ShowActivated="False"
        FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="WidgetShell" Color="#EE07111D"/>
        <SolidColorBrush x:Key="WidgetCard" Color="#F00D1A2A"/>
        <SolidColorBrush x:Key="Stroke" Color="#7CB9E8" Opacity="0.30"/>
        <SolidColorBrush x:Key="StrokeStrong" Color="#6EC1FF" Opacity="0.75"/>
        <SolidColorBrush x:Key="TextDim" Color="#B5C8DE"/>
        <SolidColorBrush x:Key="Accent" Color="#58B6FF"/>

        <LinearGradientBrush x:Key="CardGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#11233A" Offset="0"/>
            <GradientStop Color="#0D1A2A" Offset="1"/>
        </LinearGradientBrush>
    </Window.Resources>

    <Border x:Name="OuterShell"
            Background="{StaticResource WidgetShell}"
            BorderBrush="{StaticResource Stroke}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="10">
        <Border x:Name="InnerCard"
                Background="{StaticResource WidgetCard}"
                BorderBrush="{StaticResource StrokeStrong}"
                BorderThickness="1"
                CornerRadius="9"
                Padding="12,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="HeaderText"
                           Grid.Row="0"
                           Text="SCHEDULE"
                           Foreground="{StaticResource TextDim}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,4"/>

                <TextBlock x:Name="WidgetText"
                           Grid.Row="1"
                           Text="--:--:--"
                           Foreground="{StaticResource Accent}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           TextAlignment="Center"/>
            </Grid>
        </Border>
    </Border>
</Window>
