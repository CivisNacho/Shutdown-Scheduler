<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Shutdown_Scheduler_WinUI.Views.WidgetWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Shutdown Scheduler Widget">

    <Grid x:Name="Root" Background="Transparent">
        <Border
            x:Name="WidgetShell"
            Padding="14,10"
            CornerRadius="8"
            Background="{ThemeResource WidgetSurfaceBrush}"
            BorderBrush="{ThemeResource GlassPanelStrongBorderBrush}"
            BorderThickness="1">
            <Grid ColumnSpacing="12" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border
                    Grid.RowSpan="2"
                    Width="4"
                    CornerRadius="2"
                    Background="{ThemeResource WidgetAccentBrush}" />

                <TextBlock
                    x:Name="ActionText"
                    Grid.Column="1"
                    FontSize="12"
                    FontWeight="SemiBold"
                    LineHeight="15"
                    MaxLines="1"
                    TextWrapping="NoWrap"
                    TextTrimming="CharacterEllipsis"
                    Foreground="{ThemeResource SubtleTextBrush}" />

                <TextBlock
                    x:Name="TimeText"
                    Grid.Row="1"
                    Grid.Column="1"
                    FontFamily="{ThemeResource EditorialDisplayFontFamily}"
                    FontStyle="Italic"
                    FontSize="28"
                    FontWeight="SemiBold"
                    LineHeight="31"
                    MaxLines="1"
                    TextWrapping="NoWrap"
                    Foreground="{ThemeResource HeroValueBrush}"
                    TextTrimming="CharacterEllipsis" />

                <Border
                    Grid.Column="2"
                    Grid.RowSpan="2"
                    MinWidth="72"
                    Padding="10,4"
                    CornerRadius="6"
                    Background="{ThemeResource WidgetBadgeBrush}"
                    BorderBrush="{ThemeResource GlassPanelBorderBrush}"
                    BorderThickness="1"
                    VerticalAlignment="Center">
                    <TextBlock
                        x:Name="ContextText"
                        FontSize="11"
                        FontWeight="SemiBold"
                        MaxLines="1"
                        TextWrapping="NoWrap"
                        TextTrimming="CharacterEllipsis"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource HeroCaptionBrush}" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
