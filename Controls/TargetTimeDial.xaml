<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Shutdown_Scheduler_WinUI.Controls.TargetTimeDial"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="True"
    UseSystemFocusVisuals="True">

    <UserControl.Resources>
        <Style x:Key="DialChipStyle" TargetType="Button" BasedOn="{StaticResource GlassSecondaryButtonStyle}">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="0,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CornerRadius" Value="15" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="IsTabStop" Value="False" />
        </Style>
        <Style x:Key="DialChipSelectedStyle" TargetType="Button" BasedOn="{StaticResource GlassPrimaryButtonStyle}">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="0,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="CornerRadius" Value="15" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="IsTabStop" Value="False" />
        </Style>
    </UserControl.Resources>

    <StackPanel Spacing="10">
        <!-- 196x196 clock face: track ring (radius 86, 10px stroke), "now" hand, arc from now to the target,
             hour bezel, knob and readout. Geometry is computed in code-behind against these fixed dimensions. -->
        <Grid
            x:Name="DialSurface"
            Width="196"
            Height="196"
            HorizontalAlignment="Center"
            Background="Transparent">
            <Ellipse
                Width="182"
                Height="182"
                Stroke="{ThemeResource GlassPanelDividerBrush}"
                StrokeThickness="10" />
            <Ellipse
                x:Name="FullArc"
                Width="182"
                Height="182"
                Stroke="{ThemeResource PrimaryButtonBackgroundBrush}"
                StrokeThickness="10"
                Visibility="Collapsed" />
            <Path
                x:Name="ProgressArc"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Stroke="{ThemeResource PrimaryButtonBackgroundBrush}"
                StrokeThickness="10"
                StrokeStartLineCap="Flat"
                StrokeEndLineCap="Round" />
            <Path
                x:Name="MinorTicks"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Stroke="{ThemeResource MutedTextBrush}"
                StrokeThickness="1"
                Opacity="0.45" />
            <Path
                x:Name="HourTicks"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Stroke="{ThemeResource SubtleTextBrush}"
                StrokeThickness="2"
                StrokeStartLineCap="Round"
                StrokeEndLineCap="Round" />
            <Path
                x:Name="NowHand"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Stroke="{ThemeResource HeroValueBrush}"
                StrokeThickness="3"
                StrokeStartLineCap="Round"
                StrokeEndLineCap="Round" />
            <Ellipse
                x:Name="Knob"
                Width="24"
                Height="24"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Fill="{ThemeResource PrimaryButtonBackgroundBrush}"
                Stroke="{ThemeResource GlassPanelInsetBrush}"
                StrokeThickness="4">
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="KnobTransform" />
                </Ellipse.RenderTransform>
            </Ellipse>

            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsHitTestVisible="False">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
                    <TextBlock
                        x:Name="TimeText"
                        FontFamily="{StaticResource DisplayFontFamily}"
                        FontSize="36"
                        FontWeight="SemiBold"
                        LineHeight="40"
                        LineStackingStrategy="BlockLineHeight"
                        Foreground="{ThemeResource HeroValueBrush}" />
                    <TextBlock
                        x:Name="MeridiemText"
                        FontSize="13"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,6"
                        Foreground="{ThemeResource MutedTextBrush}" />
                </StackPanel>
                <TextBlock
                    x:Name="DurationText"
                    FontSize="12"
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource SubtleTextBrush}" />
                <TextBlock
                    x:Name="DayText"
                    FontSize="12"
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource MutedTextBrush}" />
            </StackPanel>
        </Grid>

        <Grid x:Name="PresetsGrid" ColumnSpacing="6" />
        <Grid x:Name="DaysGrid" ColumnSpacing="6" />
    </StackPanel>
</UserControl>
