<UserControl x:Class="Shutdown_Scheduler.Controls.DateTimePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Focusable="False">
    <UserControl.Resources>
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#0D1A2A"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#0D1A2A"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#EDF4FF"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#58B6FF"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#07111D"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#1C3F63"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#EDF4FF"/>

        <Style x:Key="ColumnOptionButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#EDF4FF"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CellBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="CellBorder" Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="Transparent"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CellBorder" Property="Background" Value="#122A42"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CellBorder" Property="Background" Value="#0D2236"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="#58B6FF"/>
                    <Setter Property="Foreground" Value="#07111D"/>
                </DataTrigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="Transparent"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ChromeIconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#EDF4FF"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="FontWeight" Value="Light"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#122A42"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#0D2236"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FieldToggleButton" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CalendarNavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#B5C8DE"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#122A42"/>
                                <Setter Property="Foreground" Value="#58B6FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#405469"/>
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CalendarDayCellButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#EDF4FF"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="DayBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DayBorder" Property="Background" Value="#122A42"/>
                                <Setter TargetName="DayBorder" Property="BorderBrush" Value="#4D7CB9E8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#405469"/>
                                <Setter TargetName="DayBorder" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="44"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="FieldBorder"
                    Grid.Column="0"
                    BorderThickness="1"
                    CornerRadius="6"
                    MinHeight="36">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#F20B1726"/>
                        <Setter Property="BorderBrush" Value="#4D7CB9E8"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=Root}" Value="True">
                                <Setter Property="BorderBrush" Value="#BF6EC1FF"/>
                                <Setter Property="Background" Value="#0E2034"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsMouseOver, ElementName=Root}" Value="True">
                                <Setter Property="Background" Value="#0E2034"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsEnabled, ElementName=Root}" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="36"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding DisplayText, ElementName=Root}"
                               Foreground="#EDF4FF"
                               FontSize="14"
                               VerticalAlignment="Center"
                               Margin="12,0,8,0"/>
                    <Path Grid.Column="1"
                          Width="10"
                          Height="6"
                          Stretch="Fill"
                          Fill="#B5C8DE"
                          Data="M 0 0 L 5 6 L 10 0 Z"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
                    <ToggleButton Grid.ColumnSpan="2"
                                  Style="{StaticResource FieldToggleButton}"
                                  IsChecked="{Binding IsPopupOpen, ElementName=Root, Mode=TwoWay}"
                                  ClickMode="Press"/>
                </Grid>
            </Border>

            <Border x:Name="DateButtonBorder"
                    Grid.Column="2"
                    BorderThickness="1"
                    CornerRadius="6"
                    MinHeight="36">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#F20B1726"/>
                        <Setter Property="BorderBrush" Value="#4D7CB9E8"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDatePopupOpen, ElementName=Root}" Value="True">
                                <Setter Property="BorderBrush" Value="#BF6EC1FF"/>
                                <Setter Property="Background" Value="#0E2034"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#0E2034"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsEnabled, ElementName=Root}" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Viewbox Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid Width="18" Height="18">
                            <Border BorderBrush="#B5C8DE" BorderThickness="1.6" CornerRadius="1.8" Margin="1.5,3,1.5,1.5"/>
                            <Line X1="1.5" Y1="7" X2="16.5" Y2="7" Stroke="#B5C8DE" StrokeThickness="1.4"/>
                            <Line X1="5.5" Y1="1" X2="5.5" Y2="4.8" Stroke="#B5C8DE" StrokeThickness="1.8"/>
                            <Line X1="12.5" Y1="1" X2="12.5" Y2="4.8" Stroke="#B5C8DE" StrokeThickness="1.8"/>
                        </Grid>
                    </Viewbox>
                    <ToggleButton Background="Transparent"
                                  Style="{StaticResource FieldToggleButton}"
                                  IsChecked="{Binding IsDatePopupOpen, ElementName=Root, Mode=TwoWay}"
                                  ClickMode="Press"/>
                </Grid>
            </Border>
        </Grid>

        <Popup IsOpen="{Binding IsPopupOpen, ElementName=Root, Mode=TwoWay}"
               Placement="Bottom"
               PlacementTarget="{Binding ElementName=FieldBorder}"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border Margin="0,4,0,0"
                    Width="324"
                    Background="#0D1A2A"
                    BorderBrush="#BF6EC1FF"
                    BorderThickness="1"
                    CornerRadius="8"
                    SnapsToDevicePixels="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="54"/>
                        <RowDefinition Height="250"/>
                        <RowDefinition Height="54"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="16,16,16,0" Background="#13283D">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" BorderBrush="#334D6B" BorderThickness="0,0,1,0">
                            <TextBlock Text="hour" Foreground="#EDF4FF" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Grid.Column="1" BorderBrush="#334D6B" BorderThickness="0,0,1,0">
                            <TextBlock Text="minute" Foreground="#EDF4FF" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Grid.Column="2" Text="AM" Foreground="#EDF4FF" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,0,0,0" ClipToBounds="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" BorderBrush="#334D6B" BorderThickness="0,0,1,0">
                            <ItemsControl ItemsSource="{Binding HourColumn, ElementName=Root}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource ColumnOptionButton}"
                                                IsEnabled="{Binding IsEnabled}"
                                                CommandParameter="{Binding Value}"
                                                Click="HourOption_Click">
                                            <TextBlock Text="{Binding Text}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <Border Grid.Column="1" BorderBrush="#334D6B" BorderThickness="0,0,1,0">
                            <ItemsControl ItemsSource="{Binding MinuteColumn, ElementName=Root}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource ColumnOptionButton}"
                                                IsEnabled="{Binding IsEnabled}"
                                                CommandParameter="{Binding Value}"
                                                Click="MinuteOption_Click">
                                            <TextBlock Text="{Binding Text}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <ItemsControl Grid.Column="2" ItemsSource="{Binding PeriodColumn, ElementName=Root}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource ColumnOptionButton}"
                                            IsEnabled="{Binding IsEnabled}"
                                            CommandParameter="{Binding Text}"
                                            Click="PeriodOption_Click">
                                        <TextBlock Text="{Binding Text}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <Border Grid.Row="2" BorderBrush="#334D6B" BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Content="✓"
                                    Style="{StaticResource ChromeIconButton}"
                                    Click="Confirm_Click"/>
                            <Button Grid.Column="1"
                                    Content="×"
                                    Style="{StaticResource ChromeIconButton}"
                                    Click="Cancel_Click"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Popup>

        <Popup IsOpen="{Binding IsDatePopupOpen, ElementName=Root, Mode=TwoWay}"
               Placement="Bottom"
               PlacementTarget="{Binding ElementName=DateButtonBorder}"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border Margin="0,4,0,0"
                    Background="#0D1A2A"
                    BorderBrush="#BF6EC1FF"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10"
                    SnapsToDevicePixels="True">
                <Grid Width="260">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="38"/>
                        <RowDefinition Height="28"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="38"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="38"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Content="‹"
                                Style="{StaticResource CalendarNavButton}"
                                IsEnabled="{Binding CanNavigatePreviousMonth, ElementName=Root}"
                                Click="PreviousMonth_Click"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding CalendarTitle, ElementName=Root}"
                                   Foreground="#EDF4FF"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="2"
                                Content="›"
                                Style="{StaticResource CalendarNavButton}"
                                IsEnabled="{Binding CanNavigateNextMonth, ElementName=Root}"
                                Click="NextMonth_Click"/>
                    </Grid>

                    <ItemsControl Grid.Row="1" ItemsSource="{Binding WeekdayLabels, ElementName=Root}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="7"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           Foreground="#8EA8C3"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl Grid.Row="2" ItemsSource="{Binding CalendarDays, ElementName=Root}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="7" Rows="6"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Text}"
                                        CommandParameter="{Binding Date}"
                                        IsEnabled="{Binding IsEnabled}"
                                        Click="CalendarDay_Click">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource CalendarDayCellButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsInCurrentMonth}" Value="False">
                                                    <Setter Property="Foreground" Value="#667F99"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                    <Setter Property="BorderBrush" Value="#BF58B6FF"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="#58B6FF"/>
                                                    <Setter Property="Foreground" Value="#07111D"/>
                                                    <Setter Property="BorderBrush" Value="#58B6FF"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
