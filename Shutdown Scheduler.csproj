<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Shutdown_Scheduler</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="ShutdownScheduler.Core\**\*.cs" />
    <EmbeddedResource Remove="ShutdownScheduler.Core\**\*" />
    <None Remove="ShutdownScheduler.Core\**\*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="ShutdownScheduler.Core\ShutdownScheduler.Core.csproj" />
  </ItemGroup>
</Project>
