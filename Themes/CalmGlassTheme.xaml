        <Setter Property="FontFamily" Value="{StaticResource DisplayFontFamily}" />
        <Setter Property="FontSize" Value="34" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LineHeight" Value="40" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="Foreground" Value="{ThemeResource HeroValueBrush}" />
    </Style>

    <Style x:Key="HeroTitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource HeroValueTextStyle}">
        <!-- Same line box as the countdown (HeroValueTextStyle), so the header keeps its height in both states. -->
        <Setter Property="FontSize" Value="24" />
        <Setter Property="LineHeight" Value="40" />
    </Style>

    <Style x:Key="HeroCaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="Foreground" Value="{ThemeResource HeroCaptionBrush}" />
    </Style>

    <Style x:Key="SectionHeadingTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFontFamily}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource SectionHeadingBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="SectionCaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource MutedTextBrush}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="FieldLabelTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource MutedTextBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="Margin" Value="0,0,0,2" />
    </Style>

    <Style x:Key="FormRowLabelStyle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="Foreground" Value="{ThemeResource SubtleTextBrush}" />
    </Style>

    <!-- Every field header (ComboBox, NumberBox, pickers) looks the same: small semibold muted label. -->
    <DataTemplate x:Key="FieldHeaderTemplate">
        <TextBlock Text="{Binding}" Style="{StaticResource FieldLabelTextStyle}" />
    </DataTemplate>

    <Style TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
        <Setter Property="HeaderTemplate" Value="{StaticResource FieldHeaderTemplate}" />
        <Setter Property="CornerRadius" Value="{StaticResource AppControlCornerRadius}" />
        <Setter Property="MinHeight" Value="36" />
    </Style>
    <Style TargetType="CalendarDatePicker">
        <Setter Property="HeaderTemplate" Value="{StaticResource FieldHeaderTemplate}" />
    </Style>
    <Style TargetType="TimePicker">
        <Setter Property="HeaderTemplate" Value="{StaticResource FieldHeaderTemplate}" />
    </Style>
    <Style TargetType="NumberBox">
        <Setter Property="HeaderTemplate" Value="{StaticResource FieldHeaderTemplate}" />
    </Style>

    <!-- Surfaces -->
    <Style x:Key="GlassSectionContainerStyle" TargetType="Border">
        <Setter Property="Padding" Value="20" />
        <Setter Property="Background" Value="{ThemeResource GlassPanelBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource GlassPanelBorderBrush}" />
        <Setter Property="BorderThickness" Value="{ThemeResource AppStrokeThickness}" />
        <Setter Property="CornerRadius" Value="{StaticResource AppCornerRadius}" />
    </Style>

    <!-- A softly tinted block that groups related fields inside a section. -->
    <Style x:Key="FieldGroupStyle" TargetType="Border">
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="Background" Value="{ThemeResource GlassPanelInsetBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource FieldGroupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{ThemeResource FieldGroupStrokeThickness}" />
        <Setter Property="CornerRadius" Value="{StaticResource AppInnerCornerRadius}" />
    </Style>

    <Style x:Key="SectionDividerStyle" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{ThemeResource GlassPanelDividerBrush}" />
    </Style>

    <!-- Rounded tile behind a section or condition icon. -->
    <Style x:Key="SectionIconTileStyle" TargetType="Border">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Background" Value="{ThemeResource GlassPanelInsetBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SectionIconStyle" TargetType="FontIcon">
        <Setter Property="FontFamily" Value="{ThemeResource SymbolThemeFontFamily}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{ThemeResource SectionIconBrush}" />
    </Style>

    <!-- Controls -->
    <Style x:Key="FormToggleSwitchStyle" TargetType="ToggleSwitch">
        <!-- The switch never shows On/Off text, so drop the room reserved for it: the 154 MinWidth (here and via
             ToggleSwitchThemeMinWidth inside the template) and the fixed 12px gap after the track. This keeps it flush right. -->
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Margin" Value="0,0,-12,0" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="OnContent" Value="" />
        <Setter Property="OffContent" Value="" />
    </Style>

    <Style x:Key="GlassPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="20,9" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CornerRadius" Value="{StaticResource AppControlCornerRadius}" />
        <Setter Property="Background" Value="{ThemeResource PrimaryButtonBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource PrimaryButtonBorderBrush}" />
        <Setter Property="BorderThickness" Value="{ThemeResource AppStrokeThickness}" />
        <Setter Property="Foreground" Value="{ThemeResource PrimaryButtonForegroundBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter
                        x:Name="ContentPresenter"
                        Background="{TemplateBinding Background}"
                        Foreground="{TemplateBinding Foreground}"
                        BackgroundSizing="{TemplateBinding BackgroundSizing}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}"
                        ContentTransitions="{TemplateBinding ContentTransitions}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                        AutomationProperties.AccessibilityView="Raw">
                        <ContentPresenter.BackgroundTransition>
                            <BrushTransition Duration="0:0:0.083" />
                        </ContentPresenter.BackgroundTransition>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Background" Value="{ThemeResource PrimaryButtonHoverBackgroundBrush}" />
                                        <Setter Target="ContentPresenter.BorderBrush" Value="{ThemeResource PrimaryButtonHoverBackgroundBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Background" Value="{ThemeResource PrimaryButtonPressedBackgroundBrush}" />
                                        <Setter Target="ContentPresenter.BorderBrush" Value="{ThemeResource PrimaryButtonPressedBackgroundBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Opacity" Value="0.45" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </ContentPresenter>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Primary button without the hover tint, for the header's schedule button. Same template, minus PointerOver. -->
    <Style x:Key="GlassPrimaryNoHoverButtonStyle" TargetType="Button" BasedOn="{StaticResource GlassPrimaryButtonStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter
                        x:Name="ContentPresenter"
                        Background="{TemplateBinding Background}"
                        Foreground="{TemplateBinding Foreground}"
                        BackgroundSizing="{TemplateBinding BackgroundSizing}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}"
                        ContentTransitions="{TemplateBinding ContentTransitions}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                        AutomationProperties.AccessibilityView="Raw">
                        <ContentPresenter.BackgroundTransition>
                            <BrushTransition Duration="0:0:0.083" />
                        </ContentPresenter.BackgroundTransition>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver" />
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Background" Value="{ThemeResource PrimaryButtonPressedBackgroundBrush}" />
                                        <Setter Target="ContentPresenter.BorderBrush" Value="{ThemeResource PrimaryButtonPressedBackgroundBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Opacity" Value="0.45" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </ContentPresenter>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GlassSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="CornerRadius" Value="{StaticResource AppControlCornerRadius}" />
        <Setter Property="Background" Value="{ThemeResource SecondaryButtonBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SecondaryButtonBorderBrush}" />
        <Setter Property="BorderThickness" Value="{ThemeResource AppStrokeThickness}" />
        <Setter Property="Foreground" Value="{ThemeResource SecondaryButtonForegroundBrush}" />
        <!-- Own template, like the primary style: the default one flashes through intermediate colors on hover
             (most visible on the dialog's close button). The background change is animated on the presenter only. -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter
                        x:Name="ContentPresenter"
                        Background="{TemplateBinding Background}"
                        Foreground="{TemplateBinding Foreground}"
                        BackgroundSizing="{TemplateBinding BackgroundSizing}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}"
                        ContentTransitions="{TemplateBinding ContentTransitions}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                        AutomationProperties.AccessibilityView="Raw">
                        <ContentPresenter.BackgroundTransition>
                            <BrushTransition Duration="0:0:0.083" />
                        </ContentPresenter.BackgroundTransition>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Background" Value="{ThemeResource ButtonBackgroundPointerOver}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Background" Value="{ThemeResource ButtonBackgroundPressed}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Opacity" Value="0.45" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </ContentPresenter>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Full-width choice row in a dialog (e.g. the add-condition list). -->
    <Style x:Key="DialogOptionButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="CornerRadius" Value="{StaticResource AppInnerCornerRadius}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{ThemeResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{ThemeResource AppStrokeThickness}" />
    </Style>

    <!-- Borderless square button for a single glyph (e.g. remove a condition). -->
    <Style x:Key="GlassIconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource AppControlCornerRadius}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{ThemeResource MutedTextBrush}" />
    </Style>

    <Style x:Key="GlassTextBoxStyle" TargetType="TextBox">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="CornerRadius" Value="{StaticResource AppControlCornerRadius}" />
        <Setter Property="Background" Value="{ThemeResource ControlBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ControlBorderBrush}" />
        <Setter Property="BorderThickness" Value="{ThemeResource AppStrokeThickness}" />
        <Setter Property="Foreground" Value="{ThemeResource ControlForegroundBrush}" />
    </Style>

    <Style x:Key="NumberBoxTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- Explicit styles replace the implicit one, so the header template is repeated here. -->
    <Style x:Key="GlassNumberBoxStyle" TargetType="NumberBox">
        <Setter Property="HeaderTemplate" Value="{StaticResource FieldHeaderTemplate}" />
        <Setter Property="Background" Value="{ThemeResource ControlBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ControlBorderBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource ControlForegroundBrush}" />
    </Style>

</ResourceDictionary>
