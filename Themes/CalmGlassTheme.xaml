            <SolidColorBrush x:Key="WidgetBadgeBrush" Color="#FF000000" />
            <SolidColorBrush x:Key="WidgetBorderBrush" Color="#FFFFFF00" />

            <Style x:Key="GlassSectionContainerStyle" TargetType="Border">
                <Setter Property="Padding" Value="18" />
                <Setter Property="Background" Value="{ThemeResource GlassPanelBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource GlassPanelBorderBrush}" />
                <Setter Property="BorderThickness" Value="{ThemeResource AppPanelStrokeThickness}" />
                <Setter Property="CornerRadius" Value="{ThemeResource AppCornerRadius}" />
            </Style>

            <Style x:Key="SectionHeadingTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource SectionHeadingBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="SectionDividerStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource GlassPanelDividerBrush}" />
                <Setter Property="Opacity" Value="1" />
            </Style>

            <Style x:Key="FormRowLabelStyle" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextWrapping" Value="NoWrap" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="Foreground" Value="{ThemeResource SubtleTextBrush}" />
            </Style>

            <Style x:Key="FormToggleSwitchStyle" TargetType="ToggleSwitch">
                <!-- The switch never shows On/Off text, so drop the room reserved for it: the 154 MinWidth (here and via
                     ToggleSwitchThemeMinWidth inside the template) and the fixed 12px gap after the track. This keeps it flush right. -->
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Margin" Value="0,0,-12,0" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="OnContent" Value="" />
                <Setter Property="OffContent" Value="" />
            </Style>

            <Style x:Key="GlassPrimaryButtonStyle" TargetType="Button">
                <Setter Property="MinHeight" Value="42" />
                <Setter Property="Padding" Value="18,10" />
                <Setter Property="CornerRadius" Value="{ThemeResource AppControlCornerRadius}" />
                <Setter Property="Background" Value="{ThemeResource PrimaryButtonBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource PrimaryButtonBorderBrush}" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="Foreground" Value="{ThemeResource PrimaryButtonForegroundBrush}" />
            </Style>

            <Style x:Key="GlassSecondaryButtonStyle" TargetType="Button">
                <Setter Property="MinHeight" Value="42" />
                <Setter Property="Padding" Value="16,10" />
                <Setter Property="CornerRadius" Value="{ThemeResource AppControlCornerRadius}" />
                <Setter Property="Background" Value="{ThemeResource SecondaryButtonBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource SecondaryButtonBorderBrush}" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="Foreground" Value="{ThemeResource SecondaryButtonForegroundBrush}" />
            </Style>

            <Style x:Key="GlassTextBoxStyle" TargetType="TextBox">
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="CornerRadius" Value="{ThemeResource AppControlCornerRadius}" />
                <Setter Property="Background" Value="{ThemeResource ControlBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource ControlBorderBrush}" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="Foreground" Value="{ThemeResource ControlForegroundBrush}" />
            </Style>

            <Style x:Key="GlassNumberBoxStyle" TargetType="NumberBox">
                <Setter Property="Background" Value="{ThemeResource ControlBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource ControlBorderBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource ControlForegroundBrush}" />
            </Style>

            <Style x:Key="GlassListViewStyle" TargetType="ListView">
                <Setter Property="CornerRadius" Value="{ThemeResource AppInnerCornerRadius}" />
                <Setter Property="Background" Value="{ThemeResource GlassPanelInsetBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource GlassPanelBorderBrush}" />
                <Setter Property="BorderThickness" Value="2" />
            </Style>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
